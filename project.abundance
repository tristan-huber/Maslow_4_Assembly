                      ],
                      "topLevel": false,
                      "allAtoms": [
                        {
                          "atomType": "Output",
                          "x": 1,
                          "y": 0.5,
                          "uniqueID": "id-2603",
                          "ioValues": [
                            {
                              "name": "number or geometry",
                              "ioValue": "__GEOMETRY_INPUT__"
                            }
                          ]
                        },
                        {
                          "atomType": "Input",
                          "x": 0,
                          "y": 0.1,
                          "uniqueID": "id-2604",
                          "name": "Shape",
                          "type": "geometry",
                          "options": []
                        },
                        {
                          "atomType": "Input",
                          "x": 0,
                          "y": 0.2,
                          "uniqueID": "id-2605",
